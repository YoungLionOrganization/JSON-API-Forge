* {
  font-family: "Inter", "Segoe UI", "SF Pro Text", sans-serif;
  font-size: 13px;
  color: #eeeae2;
  outline: none;
}

QMainWindow, QDialog, QWidget#contentArea, QStackedWidget#workspaceStack {
  background: #1a1b1e;
}

QWidget#sidebar, QWidget#sidebarContents {
  background: #24262a;
  border-right: 1px solid #41444a;
}

QWidget#workspaceHeader {
  min-height: 92px;
  background: #292b2f;
  border-bottom: 1px solid #41444a;
}

QLabel#brandText {
  color: #f5f1e8;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 2px;
}

QLabel#panelEyebrow {
  color: #9b9c9f;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  padding-top: 6px;
}

QLabel#breadcrumb {
  color: #d0d0d2;
  font-weight: 600;
  padding-left: 8px;
}

QLabel#connectionOffline, QLabel#connectionPending, QLabel#connectionOnline, QLabel#connectionLocal {
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 700;
}
QLabel#connectionOffline { color: #b4b5b8; background: #303338; }
QLabel#connectionPending { color: #f2b84b; background: #2a2418; }
QLabel#connectionOnline { color: #64d2a4; background: #162922; }
QLabel#connectionLocal { color: #78b8ff; background: #2a3034; }

QLabel#policyCard, QLabel#warningCard {
  color: #c6c6c8;
  background: #2c2f34;
  border: 1px solid #44474d;
  border-radius: 9px;
  padding: 10px;
  line-height: 1.35;
}
QLabel#warningCard { color: #f2c879; border-color: #5c4926; background: #211c14; }
QLabel#mutedText { color: #a9aaad; }
QLabel#errorText { color: #ff8f9b; background: #2b171b; border-radius: 6px; padding: 7px; }
QLabel#dialogTitle { color: #f2b84b; font-size: 21px; font-weight: 750; }

QMenuBar {
  background: #24262a;
  border-bottom: 1px solid #41444a;
  padding: 3px;
}
QMenuBar::item { padding: 6px 10px; border-radius: 5px; }
QMenuBar::item:selected { background: #3a3d42; }
QMenu {
  background: #2b2d31;
  border: 1px solid #4d5057;
  border-radius: 8px;
  padding: 6px;
}
QMenu::item { padding: 7px 30px 7px 12px; border-radius: 5px; }
QMenu::item:selected { color: #1d1f22; background: #f2b84b; }
QMenu::separator { height: 1px; background: #4d5057; margin: 5px 8px; }

QPushButton, QToolButton#disconnectButton, QToolButton#modeButton, QToolButton#iconButton, QToolButton#graphToolButton {
  min-height: 28px;
  background: #32353a;
  border: 1px solid #4d5057;
  border-radius: 7px;
  padding: 3px 12px;
  font-weight: 600;
}
QPushButton:hover, QToolButton#modeButton:hover, QToolButton#iconButton:hover, QToolButton#graphToolButton:hover { background: #3d4046; border-color: #686d77; }
QPushButton:pressed, QToolButton#modeButton:pressed { background: #25272b; }
QPushButton:default, QToolButton#modeButton:checked {
  color: #202225;
  background: #f2b84b;
  border-color: #ffd071;
}
QPushButton:disabled, QToolButton:disabled { color: #777a80; background: #292b2f; border-color: #3b3e43; }
QToolButton#iconButton { min-width: 30px; padding: 2px; font-size: 17px; }
QToolButton#graphToolButton { min-height: 26px; padding: 2px 10px; color: #c7c7ca; }

QLineEdit, QTextEdit, QPlainTextEdit, QTableWidget, QTreeWidget, QListWidget, QComboBox {
  selection-background-color: #a86f19;
  selection-color: #ffffff;
}
QTextEdit, QPlainTextEdit, QTableWidget, QTreeWidget, QListWidget {
  color: #d7d6d3;
  background: #1c1e21;
  alternate-background-color: #25272b;
  border: 1px solid #41444a;
  border-radius: 7px;
}
QTreeWidget::item, QTableWidget::item { min-height: 25px; padding: 2px 5px; }
QLineEdit {
  min-height: 30px;
  background: #292b2f;
  border: 1px solid #565a62;
  border-radius: 7px;
  padding: 2px 9px;
}
QLineEdit:focus { border: 1px solid #dfa33a; }
QComboBox {
  min-height: 30px;
  background: #292b2f;
  border: 1px solid #565a62;
  border-radius: 7px;
  padding: 2px 9px;
}
QComboBox:hover, QComboBox:focus { border-color: #dfa33a; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #2b2d31; border: 1px solid #565a62; selection-background-color: #a86f19; }

QListWidget#projectList, QTreeWidget#documentTree, QListWidget#componentPalette, QListWidget#graphPalette {
  background: transparent;
  border: none;
}
QListWidget#projectList::item, QTreeWidget#documentTree::item, QListWidget#componentPalette::item, QListWidget#graphPalette::item {
  min-height: 28px;
  border-radius: 6px;
  padding: 3px 7px;
  color: #c6c6c8;
}
QListWidget#projectList::item:hover, QTreeWidget#documentTree::item:hover, QListWidget#componentPalette::item:hover, QListWidget#graphPalette::item:hover {
  color: #f5f2eb;
  background: #34373c;
}
QListWidget#projectList::item:selected, QTreeWidget#documentTree::item:selected {
  color: #f8ca67;
  background: #292316;
}
QListWidget#componentPalette::item {
  background: #30343a;
  border: 1px solid #4a4d54;
  margin: 2px 0;
}
QListWidget#graphPalette::item {
  min-height: 34px;
  color: #d7d6d3;
  background: #2c3035;
  border: 1px solid #4b4e55;
  border-left: 3px solid #d69b35;
  margin: 2px 0;
}
QListWidget#graphPalette::item:selected { color: #232529; background: #f2b84b; border-color: #f2b84b; }

QPlainTextEdit#codeEditor {
  background: #1a1c1f;
  color: #e8e5df;
  border: none;
  padding: 12px 14px;
  font-family: "JetBrains Mono", "Cascadia Code", "SFMono-Regular", monospace;
  font-size: 13px;
}

QWidget#visualDesigner { background: #1a1c1f; }
QWidget#nodeGraphEditor { background: #1b1d20; }
QWidget#graphToolbar {
  background: #25272b;
  border-bottom: 1px solid #474a50;
}
QGraphicsView#graphCanvas { border: none; background: #1b1d20; }
QLabel#graphNodeType {
  color: #f5c45f;
  background: #303237;
  border: 1px solid #4b3d24;
  border-radius: 7px;
  padding: 8px;
  font-family: "JetBrains Mono", "Cascadia Code", monospace;
  font-weight: 700;
}
QPlainTextEdit#graphProperties, QPlainTextEdit#sdkSnippet {
  color: #e1dfda;
  background: #191b1e;
  border: 1px solid #4a4d53;
  border-radius: 7px;
  padding: 7px;
  font-family: "JetBrains Mono", "Cascadia Code", "SFMono-Regular", monospace;
  font-size: 12px;
}
QWidget#welcomePage {
  background: qradialgradient(cx:0.5, cy:0.42, radius:0.72, fx:0.5, fy:0.42,
                              stop:0 #303338, stop:0.52 #202225, stop:1 #1a1b1e);
}
QLabel#welcomeLogo { background: transparent; }
QLabel#welcomeBadge {
  color: #e4aa3d;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2px;
}
QLabel#welcomeTitle {
  color: #f8f4eb;
  font-size: 28px;
  font-weight: 750;
}
QLabel#welcomeText {
  color: #abacaf;
  font-size: 13px;
  line-height: 1.5;
}
QPushButton#primaryButton {
  color: #202225;
  background: #f2b84b;
  border-color: #ffd071;
}
QPushButton#primaryButton:hover { background: #ffd985; }
QTreeWidget#designerCanvas, QTableWidget#propertyTable {
  background: #202225;
  border: none;
  gridline-color: #40434a;
  alternate-background-color: #27292d;
}
QTreeWidget#designerCanvas::item, QTableWidget#propertyTable::item { min-height: 28px; padding: 3px 6px; }
QTreeWidget#designerCanvas::item:selected, QTableWidget#propertyTable::item:selected { background: #2b2417; color: #f5c76a; }

QHeaderView::section {
  color: #9a9b9e;
  background: #2a2c30;
  border: none;
  border-bottom: 1px solid #46494f;
  padding: 7px 8px;
  font-size: 10px;
  font-weight: 700;
}

QSplitter::handle { background: #41444a; }
QSplitter::handle:hover { background: #e4a83b; }
QScrollBar:vertical { width: 10px; margin: 2px; background: transparent; }
QScrollBar::handle:vertical { min-height: 32px; background: #565a62; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #727781; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { height: 10px; background: transparent; }
QScrollBar::handle:horizontal { min-width: 32px; background: #565a62; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QProgressBar { background: #3a3d42; border: none; border-radius: 3px; }
QProgressBar::chunk { background: #f2b84b; border-radius: 3px; }
QStatusBar { color: #a2a3a6; background: #202225; border-top: 1px solid #3c3f44; }
QToolBar#pluginToolBar { background: #292b2f; border-bottom: 1px solid #41444a; spacing: 5px; padding: 4px; }
QDockWidget { color: #eeeae2; font-weight: 700; }
QDockWidget::title {
  background: #2c2e32;
  border-bottom: 1px solid #474a50;
  padding: 8px 10px;
  text-align: left;
}
QWidget#pythonSdkPanel { background: #222428; }
QLabel#sdkInstallCard {
  color: #f6c86b;
  background: #211c14;
  border: 1px solid #594621;
  border-radius: 7px;
  padding: 8px 10px;
  font-family: "JetBrains Mono", "Cascadia Code", monospace;
}
QCheckBox { spacing: 8px; color: #c6c6c8; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #656a74; border-radius: 4px; background: #24262a; }
QCheckBox::indicator:checked { background: #f2b84b; border-color: #f2b84b; }
QToolTip { color: #f2efe8; background: #32353a; border: 1px solid #5a5e66; padding: 5px; }

/* v0.5.1 account, database and collaboration workspace */
QWidget#teamWorkspace { background: #202225; }
QWidget#teamTabContent, QScrollArea#teamTabScroll { background: #24262a; }
QWidget#teamHeader {
  background: #292b2f;
  border: 1px solid #41444a;
  border-radius: 10px;
}
QLabel#teamProfile { color: #eeeae2; font-weight: 700; }
QLabel#teamProject { color: #f2b84b; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
QTabWidget#teamTabs::pane { border: 1px solid #41444a; border-radius: 8px; background: #24262a; }
QTabWidget#teamTabs QTabBar::tab {
  color: #b4b5b8;
  background: #292b2f;
  border: 1px solid #41444a;
  border-bottom: none;
  padding: 8px 12px;
  margin-right: 2px;
}
QTabWidget#teamTabs QTabBar::tab:selected { color: #202225; background: #f2b84b; border-color: #ffd071; }
QTabWidget#teamTabs QTabBar::tab:disabled { color: #696c72; background: #23252a; }
QPushButton#teamActionButton { color: #d7d6d3; background: #32353a; border-color: #4d5057; }
QPushButton#teamActionButton:hover { color: #ffd071; border-color: #dfa33a; }
QListWidget#areaList {
  background: #1a1b1e;
  border: 1px solid #41444a;
  border-radius: 8px;
  padding: 5px;
}
QListWidget#areaList::item { min-height: 40px; padding: 6px 8px; border-radius: 6px; color: #c6c6c8; }
QListWidget#areaList::item:selected { color: #202225; background: #f2b84b; }
QDockWidget#teamWorkspaceDock::title { color: #f2b84b; background: #292b2f; }

QWidget#visualPanel { background: #24262a; border: 1px solid #3e4147; border-radius: 8px; }
QWidget#visualToolbar { background: #24262a; }
QLabel#visualSummary { color: #eed4a3; background: #28251f; padding: 10px 14px; border-radius: 6px; }
QLabel#visualSelection { color: #f2b84b; padding: 4px 0; font-weight: 700; }
QLabel#visualFeedback { color: #a6a8ad; font-size: 11px; }
QLabel#editorVersion { color: #cda755; font-size: 11px; padding-left: 54px; }
QLabel#spaceAvailability { color: #f4d495; background: #332c20; border-radius: 5px; padding: 7px; }
QPushButton#addComponentButton { background: #f2b84b; color: #202225; font-weight: 700; }
QListWidget#componentPalette::item { padding: 7px; border: 1px solid #41444a; border-radius: 6px; }
QListWidget#componentPalette::item:selected { background: #3e3524; color: #ffd071; border-color: #b78a3b; }
QTableWidget#propertyTable::item { padding: 5px; }
QSpinBox { background: #1d1f23; color: #eeeae2; border: 1px solid #4c5058; padding: 5px; border-radius: 4px; }
QTextBrowser#messageList { background: #25272c; border: none; border-radius: 8px; color: #e4e5e8; }
QPlainTextEdit#messageComposer { background: #35383f; border: 1px solid #515660; border-radius: 8px; padding: 7px; font-family: "Segoe UI", sans-serif; font-size: 13px; color: #eceef2; }
QPlainTextEdit#messageComposer:focus { border-color: #f2b84b; }
QLabel#conversationTitle { color: #eceef2; font-size: 15px; font-weight: 700; padding: 4px; }
QLabel#transferStatus { color: #a6a9b2; font-size: 11px; }
