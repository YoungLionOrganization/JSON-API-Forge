{
  "$schema": "../../../schemas/editor-graph.schema.json",
  "schema_version": 1,
  "target_document": "config/50-operations.json",
  "metadata": {
    "name": "Subscription Platform transition",
    "compiler": "json-api-forge-editor"
  },
  "nodes": [
    {
      "id": "request",
      "type": "request.input",
      "title": "Transition request",
      "x": 0,
      "y": 0,
      "properties": {
        "method": "POST",
        "input_schema": {
          "type": "object",
          "required": [
            "record_id",
            "next_status",
            "actor_id"
          ],
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "type": "integer",
              "minimum": 1
            },
            "next_status": {
              "type": "string",
              "enum": [
                "trial",
                "active",
                "past_due",
                "paused",
                "cancelled"
              ]
            },
            "actor_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96
            },
            "reason": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    {
      "id": "policy",
      "type": "auth.policy",
      "title": "Scoped authorization",
      "x": 300,
      "y": 0,
      "properties": {
        "permission": "subscriptions.accounts.transition",
        "public": false
      }
    },
    {
      "id": "update",
      "type": "data.mutate",
      "title": "Update active record",
      "x": 600,
      "y": 0,
      "properties": {
        "sql": "UPDATE subscriptions_accounts SET status = :next_status, updated_at = CURRENT_TIMESTAMP WHERE id = :record_id AND deleted_at IS NULL",
        "mode": "execute",
        "params": {
          "next_status": "$body.next_status",
          "record_id": "$body.record_id"
        },
        "require_rowcount_min": 1,
        "require_rowcount_max": 1,
        "result_name": "transition"
      }
    },
    {
      "id": "audit",
      "type": "data.mutate",
      "title": "Record audit event",
      "x": 900,
      "y": 0,
      "properties": {
        "sql": "INSERT INTO subscriptions_audit_events (record_id, event_type, actor_id, payload, idempotency_key, created_at) VALUES (:record_id, :event_type, :actor_id, :payload, :idempotency_key, CURRENT_TIMESTAMP)",
        "mode": "execute",
        "params": {
          "record_id": "$body.record_id",
          "event_type": "status.transitioned",
          "actor_id": "$body.actor_id",
          "payload": "$body.next_status",
          "idempotency_key": "$header.Idempotency-Key"
        },
        "result_name": "audit"
      }
    },
    {
      "id": "operation",
      "type": "operation.call",
      "title": "Forge operation",
      "x": 1200,
      "y": 0,
      "properties": {
        "name": "subscriptions.transition",
        "method": "POST",
        "database": "primary",
        "idempotency": true,
        "summary": "Atomic, idempotent state transition with audit insertion",
        "invalidate_resources": [
          "subscriptions/accounts",
          "subscriptions/audit-events"
        ],
        "invalidate_operations": [
          "subscriptions.dashboard"
        ]
      }
    },
    {
      "id": "response",
      "type": "response.output",
      "title": "Operation result",
      "x": 1500,
      "y": 0,
      "properties": {
        "status_code": 200
      }
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "from_node": "request",
      "from_port": "exec",
      "to_node": "policy",
      "to_port": "exec"
    },
    {
      "id": "edge-2",
      "from_node": "policy",
      "from_port": "exec",
      "to_node": "update",
      "to_port": "exec"
    },
    {
      "id": "edge-3",
      "from_node": "update",
      "from_port": "exec",
      "to_node": "audit",
      "to_port": "exec"
    },
    {
      "id": "edge-4",
      "from_node": "audit",
      "from_port": "exec",
      "to_node": "operation",
      "to_port": "exec"
    },
    {
      "id": "edge-5",
      "from_node": "operation",
      "from_port": "exec",
      "to_node": "response",
      "to_port": "exec"
    }
  ]
}
